rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidAmount(amount) {
      return amount is number && amount > 0;
    }

    function isValidTransactionType(type) {
      return type in ['income', 'expense', 'transfer'];
    }

    function isValidTitle(title) {
      return title is string && title.size() >= 1 && title.size() <= 100;
    }

    function isValidTransaction() {
      let d = request.resource.data;
      return isValidAmount(d.amount)
          && isValidTransactionType(d.type)
          && isValidTitle(d.title);
    }

    // ── User profile ────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false; // Never allow user deletion from client

      // ── Wallets subcollection ──────────────────────────────────────────────

      match /wallets/{walletId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if false; // Use is_archived soft delete instead
      }

      // ── Transactions subcollection ─────────────────────────────────────────

      match /transactions/{txId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && isValidTransaction();
        allow update: if isOwner(uid) && isValidTransaction();
        allow delete: if isOwner(uid);
      }

      // ── Categories subcollection ───────────────────────────────────────────

      match /categories/{catId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Budgets subcollection ──────────────────────────────────────────────

      match /budgets/{budgetId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Savings goals subcollection ────────────────────────────────────────

      match /savings/{goalId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);

        match /contributions/{contribId} {
          allow read:   if isOwner(uid);
          allow create: if isOwner(uid);
          allow update: if isOwner(uid);
          allow delete: if isOwner(uid);
        }
      }

      // ── Notes subcollection ────────────────────────────────────────────────

      match /notes/{noteId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Tags subcollection ─────────────────────────────────────────────────

      match /tags/{tagId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Reminders subcollection ────────────────────────────────────────────

      match /reminders/{reminderId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }
    }

    // ── Deny all other paths ────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
